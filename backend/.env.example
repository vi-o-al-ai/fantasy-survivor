# Copy to .env for local development. Never commit .env.
APP_ENV=local
LOG_LEVEL=DEBUG
LOG_FORMAT=console          # console | json
CORS_ORIGINS=["http://localhost:5173"]

# --- Auth ---------------------------------------------------------------
# Real Auth0 (works locally too; add http://localhost:5173 to the tenant's
# allowed callback URLs):
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.fantasy-survivor.local

# OR, for API-only work without a browser, use a locally signed key.
# Run `python scripts/mint_dev_token.py` to create the key and a token.
# Refused when APP_ENV is dev/prod.
# AUTH_LOCAL_JWKS_FILE=.local/dev-jwks.json

# --- Storage ------------------------------------------------------------
STORE_BACKEND=memory        # memory | dynamodb
# For DynamoDB Local (`make db` then `make db-create`):
# STORE_BACKEND=dynamodb
# DYNAMODB_TABLE=fantasy-survivor
# DYNAMODB_ENDPOINT_URL=http://localhost:8001
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
