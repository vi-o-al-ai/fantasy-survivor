# Copy to .env.local (git-ignored). Vite exposes only VITE_* to the browser.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.fantasy-survivor.local
# Local dev proxies /api -> http://localhost:8000 (see vite.config.ts).
# For a deployed build set the API Gateway URL from `terraform output api_url`.
VITE_API_URL=/api

# Skip Auth0 entirely (dev server only; refused in production builds). Log in
# on /local-login with a token from `python scripts/mint_dev_token.py`.
# VITE_AUTH_MODE=local
